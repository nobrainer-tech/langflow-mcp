{
  "name": "langflow-mcp-server",
  "version": "4.12.2",
  "description": "Integration for Langflow API 1.12.4 via Model Context Protocol (MCP)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "langflow-mcp-server": "./dist/mcp/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "start": "node dist/mcp/index.js",
    "start:http": "MCP_MODE=http node dist/mcp/index.js",
    "dev": "npm run build && npm run start",
    "dev:http": "npm run typecheck && MCP_MODE=http tsx watch --clear-screen=false src/mcp/index.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nobrainer-tech/langflow-mcp.git"
  },
  "keywords": [
    "langflow",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai",
    "workflow",
    "automation",
    "langflow-api",
    "claude",
    "ai-tools",
    "llm",
    "rag",
    "knowledge-base",
    "flow-automation"
  ],
  "author": "nobrainer-tech",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nobrainer-tech/langflow-mcp/issues"
  },
  "homepage": "https://github.com/nobrainer-tech/langflow-mcp#readme",
  "files": [
    "dist/**/*",
    ".env.example",
    "healthcheck.js",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "axios-mock-adapter": "^2.1.0",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.20.0",
    "dotenv": "^18.0.5",
    "form-data": "^4.0.6",
    "zod": "^4.6.5"
  }
}
