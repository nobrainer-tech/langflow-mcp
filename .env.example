# Langflow MCP Server Configuration

# ====================
# LANGFLOW API CONFIGURATION
# ====================

# Langflow instance base URL (without /api/v1 suffix)
# Example: http://localhost:7860 or https://your-langflow-instance.com
LANGFLOW_BASE_URL=http://localhost:7860

# Langflow API Key
# Get this from your Langflow instance settings
LANGFLOW_API_KEY=your-api-key-here

# API request timeout in milliseconds (default: 30000)
LANGFLOW_TIMEOUT=30000

# ====================
# MCP SERVER CONFIGURATION
# ====================

# Server mode: stdio (local) or http (remote)
MCP_MODE=stdio

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# Node Environment (development, production)
NODE_ENV=development

# Enable deprecated tools (true/false)
# Set to false to hide deprecated tools from the tool list
# Deprecated tools are marked with ⚠️ in their descriptions
ENABLE_DEPRECATED_TOOLS=true

# ====================
# HTTP MODE CONFIGURATION
# ====================
# Only used when MCP_MODE=http

# HTTP Server Configuration
PORT=3000
# Keep local deployments on loopback. Set HOST=0.0.0.0 only with AUTH_TOKEN
# and a TLS-terminating reverse proxy.
HOST=127.0.0.1

# Authentication token for HTTP mode
# Generate with: openssl rand -base64 32
AUTH_TOKEN=your-secure-token-here

# Optional exact origins for browser-based MCP clients (comma-separated).
# Wildcard origins are not accepted.
MCP_ALLOWED_ORIGINS=

# Optional: return JSON instead of SSE for single HTTP requests.
# Streamable HTTP clients normally support the default SSE response.
MCP_HTTP_JSON_RESPONSES=false

# HTTP resource limits. The defaults are safe for a small self-hosted server.
# MCP_MAX_SESSIONS=100
# MCP_SESSION_IDLE_TIMEOUT_MS=1800000
# MCP_MAX_CONCURRENT_REQUESTS=100
# MCP_MAX_CONCURRENT_BODY_BYTES=67108864
# MCP_REQUEST_BODY_TIMEOUT_MS=30000
# MCP_SHUTDOWN_TIMEOUT_MS=5000
